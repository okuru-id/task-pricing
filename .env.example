# Postgres (lokal: docker run --name taskpricer-db -p 5433:5432 ...)
DATABASE_URL="postgresql://taskpricer:taskpricer@localhost:5433/taskpricer?schema=public"

# Auth.js — generate dengan: npx auth secret
AUTH_SECRET=""

# Provider AI (OpenAI-compatible). Kosongkan baris yang tidak dipakai
# dengan cara meng-comment, JANGAN diisi string kosong — SDK akan crash.
OPENAI_API_KEY=""
OPENAI_BASE_URL="http://localhost:20128/v1"
OPENAI_MODEL="glm/glm-5.3-flash"

# Google OAuth — opsional, aktif otomatis jika keduanya diisi
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
