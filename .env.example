# Postgres (lokal: docker run --name taskpricer-db -p 5433:5432 ...)
DATABASE_URL="postgresql://taskpricer:taskpricer@localhost:5433/taskpricer?schema=public"

# Auth.js — generate dengan: npx auth secret
AUTH_SECRET=""

# Provider AI TIDAK dikonfigurasi di sini. Aplikasi ini BYOK: tiap workspace mengisi provider, model, dan
# API key sendiri di menu Settings (disimpan di database; key dienkripsi dengan kunci turunan AUTH_SECRET).
# Jangan mengganti AUTH_SECRET setelah ada key tersimpan — key lama tidak akan terbaca dan harus diisi ulang.

# Google OAuth — opsional, aktif otomatis jika keduanya diisi
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
